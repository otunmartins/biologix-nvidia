# Biologix-NVIDIA configuration template.
# Copy to .env and fill in. NEVER commit .env.
#
#   cp .env.example .env
#
# Every adapter is optional. With no credentials the platform still runs
# end-to-end using the deterministic baseline generator, RDKit screening and
# CPU simulation. Adapters that lack credentials report `unavailable` rather
# than returning fabricated values.

# ---------------------------------------------------------------------------
# NVIDIA API credentials
# ---------------------------------------------------------------------------
# Personal API key from https://build.nvidia.com (used for hosted NIM calls).
# Format is typically "nvapi-...".
NVIDIA_API_KEY=

# NGC API key, used only to `docker login nvcr.io` and pull NIM containers
# for self-hosting. Not needed for hosted endpoints.
NGC_API_KEY=

# ---------------------------------------------------------------------------
# BioNeMo ESM-2 (protein embeddings)
# ---------------------------------------------------------------------------
# Hosted endpoint — RETIRED. Probed 2026-10-14: this path is correct (the
# vendor prefix is `meta`, not `nvidia`), but NVIDIA ended the hosted ESM-2
# endpoint's life on 2026-08-25 and it now answers HTTP 410 Gone. No successor
# is named in the response. Use the self-hosted container block below instead.
BIOLOGIX_ESM2_BASE_URL=https://health.api.nvidia.com/v1/biology
BIOLOGIX_ESM2_PATH=/meta/esm2-650m
# Model identifier recorded in provenance alongside every embedding.
BIOLOGIX_ESM2_MODEL=esm2-650m
# Hard limit on residues per request. ESM-2 emits at most 1022 residue
# embeddings; we refuse longer chains instead of silently truncating.
BIOLOGIX_ESM2_MAX_RESIDUES=1022

# To use a self-hosted ESM-2 NIM container instead, point at it directly:
# BIOLOGIX_ESM2_BASE_URL=http://127.0.0.1:8010
# BIOLOGIX_ESM2_PATH=/v1/embeddings

# ---------------------------------------------------------------------------
# BioNeMo GenMol (fragment-based molecule generation)
# ---------------------------------------------------------------------------
# Self-hosted NIM container, verified against NVIDIA docs for genmol 2.0.0:
#   docker run --rm --gpus all -p 8000:8000 nvcr.io/nim/nvidia/genmol:2.0.0
BIOLOGIX_GENMOL_BASE_URL=http://127.0.0.1:8000
BIOLOGIX_GENMOL_PATH=/generate
BIOLOGIX_GENMOL_MODEL=genmol-2.0.0
# Set true if your GenMol deployment is the hosted build.nvidia.com endpoint
# rather than a local container (changes auth header handling).
BIOLOGIX_GENMOL_HOSTED=false
#
# GenMol is ALSO available as a hosted endpoint, so with NVIDIA_API_KEY set you
# do not need a GPU or a container. VERIFY the path against your own
# build.nvidia.com GenMol model page before relying on it:
# BIOLOGIX_GENMOL_BASE_URL=https://health.api.nvidia.com/v1/biology
# BIOLOGIX_GENMOL_PATH=/nvidia/genmol/generate
# BIOLOGIX_GENMOL_HOSTED=true

# ---------------------------------------------------------------------------
# BioNeMo MolMIM (latent-space molecule sampling)
# ---------------------------------------------------------------------------
# Hosted by default. Self-hosted alternative:
#   docker run --rm --gpus all -p 8002:8000 nvcr.io/nim/nvidia/molmim:1.0.0
#   BIOLOGIX_MOLMIM_BASE_URL=http://127.0.0.1:8002
#   BIOLOGIX_MOLMIM_PATH=/generate
BIOLOGIX_MOLMIM_BASE_URL=https://health.api.nvidia.com/v1/biology
BIOLOGIX_MOLMIM_PATH=/nvidia/molmim/generate
BIOLOGIX_MOLMIM_MODEL=molmim-1.0.0
# NOTE: MolMIM's built-in objectives (QED, plogP) are oral-drug-likeness
# scores and are a poor fit for excipient design, so the adapter defaults to
# similarity-constrained sampling (algorithm="none"). CMA-ES must be asked for
# explicitly and is recorded with a caveat in the run manifest.

# ---------------------------------------------------------------------------
# BioNeMo Boltz-2 (complex structure + binding affinity)
# ---------------------------------------------------------------------------
#   docker run --rm --gpus all -p 8003:8000 nvcr.io/nim/mit/boltz2:latest
#   BIOLOGIX_BOLTZ2_BASE_URL=http://127.0.0.1:8003
#   BIOLOGIX_BOLTZ2_PATH=/predict
BIOLOGIX_BOLTZ2_BASE_URL=https://health.api.nvidia.com/v1/biology
BIOLOGIX_BOLTZ2_PATH=/mit/boltz2/predict
BIOLOGIX_BOLTZ2_MODEL=boltz2-1.10.0
# Documented request ceilings. These changed between NIM releases (1.0.0
# documented 5 polymers / 5 ligands; later releases 12 / 20), so set them to
# match the release you deploy. Exceeding them fails client-side with a clear
# message instead of as an opaque HTTP 422.
BIOLOGIX_BOLTZ2_MAX_POLYMERS=12
BIOLOGIX_BOLTZ2_MAX_LIGANDS=20
BIOLOGIX_BOLTZ2_MAX_SEQUENCE=4096

# ---------------------------------------------------------------------------
# BioNeMo DiffDock (blind docking)
# ---------------------------------------------------------------------------
#   docker run --rm --gpus all -p 8001:8000 nvcr.io/nim/mit/diffdock:2.1.0
#   BIOLOGIX_DIFFDOCK_BASE_URL=http://127.0.0.1:8001
#   BIOLOGIX_DIFFDOCK_PATH=/molecular-docking/diffdock/generate
BIOLOGIX_DIFFDOCK_BASE_URL=https://health.api.nvidia.com/v1/biology
BIOLOGIX_DIFFDOCK_PATH=/mit/diffdock
BIOLOGIX_DIFFDOCK_MODEL=diffdock-2.1.0

# ---------------------------------------------------------------------------
# Execution backends
# ---------------------------------------------------------------------------
# auto | CPU | CUDA | OpenCL | Reference
# "auto" prefers CUDA, then OpenCL, then CPU, and records what it actually
# used. Naming a platform explicitly makes a run FAIL if it is unavailable.
BIOLOGIX_OPENMM_PLATFORM=auto

# Enable the nvMolKit GPU paths. Requires an NVIDIA GPU with compute
# capability >= 7.0 and CUDA 12.6+. When false (or when import fails) all
# chemistry runs through RDKit on CPU.
BIOLOGIX_ENABLE_NVMOLKIT=false

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
BIOLOGIX_DATA_DIR=./var
BIOLOGIX_CACHE_DIR=./var/cache

# SQLite by default, so a local run needs no database server.
#
# Postgres (Neon, RDS, anything) is a one-line swap — no model or query in this
# codebase is dialect-specific. Two things come with it:
#
#   1. install the driver:  uv pip install -e ".[postgres]"
#   2. create the schema:   alembic upgrade head
#
# The second is not optional. Against anything but SQLite the application
# refuses to start on an un-migrated database rather than creating tables
# itself, so the schema always has a migration history behind it.
#
# Neon: copy the connection string from the project dashboard and change the
# scheme to postgresql+psycopg. Prefer the *pooled* host for a web app. Keep
# sslmode=require — Neon needs TLS, and the driver will not add it for you.
#
#   BIOLOGIX_DATABASE_URL=postgresql+psycopg://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
#
BIOLOGIX_DATABASE_URL=sqlite+pysqlite:///./var/biologix.db

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Google sign-in (optional)
# ---------------------------------------------------------------------------
# Leaving these unset is a working state, not a broken one: /auth/providers
# reports Google as unconfigured, the sign-in page omits the button entirely,
# and the endpoints refuse with a reason. Filling in the two credentials is
# the whole change.
#
# In the Google Cloud console: APIs & Services -> Credentials -> Create
# credentials -> OAuth client ID -> Web application. Add the callback below
# as an "Authorised redirect URI", character for character.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# This points at the FRONTEND proxy, not at this API, and that is deliberate:
# the session cookie has to be set on the origin the browser is actually
# using. The callback travels back through the Next.js proxy, which forwards
# Set-Cookie and Location to the browser.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/bx/auth/google/callback
#
# Comma-separated email domains allowed to sign in with Google. Empty means
# any Google account with a verified address, which is rarely what an internal
# tool wants — a single lab almost certainly wants its own domain here.
GOOGLE_ALLOWED_DOMAINS=
#
# Where the browser lands after a successful sign-in.
BIOLOGIX_OAUTH_SUCCESS_PATH=/

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# development | production. Nothing is inferred from the hostname: a
# deployment states what it is. "production" defaults the session cookie to
# Secure, and refuses an explicit attempt to turn that off.
BIOLOGIX_ENV=development
BIOLOGIX_HOST=127.0.0.1
BIOLOGIX_PORT=8080
# Comma-separated origins allowed to call the API from a browser.
BIOLOGIX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Worker threads for the background job queue.
BIOLOGIX_JOB_WORKERS=2

# ---------------------------------------------------------------------------
# Reproducibility
# ---------------------------------------------------------------------------
# Default seed recorded in every run manifest.
BIOLOGIX_SEED=20260101
# Allow outbound network calls (structure downloads, literature, NIMs).
# Set false for fully offline/airgapped operation.
BIOLOGIX_ALLOW_NETWORK=true
